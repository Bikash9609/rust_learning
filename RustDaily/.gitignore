# Rust specific ignores

# Generated by Cargo
/target/
**/target/

# Remove Cargo.lock from gitignore if building libraries
Cargo.lock

# Backup files
*.rs.bk

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo

# Byebug command history
.byebug_history

# MacOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Executables
*.exe
*.dll
*.so
*.dylib
*.rlib

# Coverage
/coverage/

# Logs
*.log

# Node modules (if using node in project)
node_modules/