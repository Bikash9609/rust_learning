# Generated by Cargo
# Will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here: https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# IDE-specific files
.idea/
.vscode/
*.swp
*.swo

# Rust cache and incremental compilation files
**/*.rlib
**/*.d
**/*.o
**/*.so
**/*.dylib
**/*.dll
**/*.exe

# Debugging symbols
*.pdb

# Local development environment files
.env
.env.local

# Build output for wasm-pack
/pkg/
/out/

# Coverage files generated by cargo-tarpaulin or other tools
/coverage/

# Documentation generated by `cargo doc`
/doc/

# MacOS-specific files
.DS_Store

# Windows-specific files
Thumbs.db

# Editor-specific files
*.sublime-workspace
*.sublime-project

# Cargo build artifacts
**/Cargo.toml.bk
**/Cargo.toml.orig

# Rustfmt configuration file (if not tracked)
rustfmt.toml

# Clippy configuration file (if not tracked)
.clippy.toml

# Cargo configuration file (if not tracked)
.cargo/config.toml

# Temporary files
*.tmp
*.log